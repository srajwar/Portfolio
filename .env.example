# Contact form email delivery (https://resend.com). Without these, the form
# returns an error and asks visitors to email directly instead.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified in Resend.
# Resend's test sender works for trying it out: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Public site URL, used for sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app
